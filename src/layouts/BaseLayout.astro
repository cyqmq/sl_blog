---
import { ViewTransitions } from 'astro:transitions';
import '../styles/global.css';
import 'katex/dist/katex.min.css';
import { site, accents, comments, music } from '../config/site';
import Icon from '../components/Icon.astro';
import MusicPlayer from '../components/MusicPlayer.astro';

interface Props {
  title: string;
  description?: string;
}
const { title, description = site.description } = Astro.props;
const year = new Date().getFullYear();
const path = Astro.url.pathname;
const navItems = [
  { href: '/', label: '导航' },
  { href: '/blog', label: '博客' },
  { href: '/search', label: '搜索' },
  { href: '/about', label: '关于' },
  { href: '/admin', label: '管理' },
];
---

<!doctype html>
<html lang="zh-CN" data-theme="dark" data-accent="blue">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title}</title>
    <ViewTransitions />
    <!-- 在首屏绘制前应用主题，避免闪烁 -->
    <script is:inline>
      (() => {
        try {
          const t = localStorage.getItem('theme') || 'dark';
          const a = localStorage.getItem('accent') || 'blue';
          const root = document.documentElement;
          root.setAttribute('data-theme', t);
          root.setAttribute('data-accent', a);
          root.classList.toggle('dark', t !== 'light');
        } catch (e) {}
      })();
    </script>
  </head>
  <body>
    <header class="site-header">
      <div class="wrap">
        <a class="brand" href="/">
          <span class="logo">◆</span> {site.title}
        </a>
        <nav class="nav-links">
          {navItems.map((n) => (
            <a
              href={n.href}
              aria-current={path === n.href || (n.href !== '/' && path.startsWith(n.href)) ? 'page' : undefined}
            >
              {n.label}
            </a>
          ))}
        </nav>
        <div class="theme-controls">
          <div class="accent-swatches">
            {accents.map((ac) => (
              <button
                class="swatch"
                data-accent={ac.id}
                aria-label={`主题色 ${ac.label}`}
                aria-pressed="false"
                style={`background:${ac.color}`}
                data-swatch
              ></button>
            ))}
          </div>
          <button class="icon-btn" id="theme-toggle" aria-label="切换深浅色">
            <Icon name="moon" size={18} id="theme-icon" />
          </button>
        </div>
      </div>
    </header>

    <main class="wrap" data-pagefind-body>
      <slot />
    </main>

    <footer class="footer">
      <div class="wrap">© {year} {site.title} · Powered by Astro + Cloudflare Pages</div>
    </footer>

    <MusicPlayer />

    <script>
      // 主题切换与主题色选择，持久化到 localStorage
      const root = document.documentElement;
      const toggle = document.getElementById('theme-toggle') as HTMLButtonElement | null;
      const icon = document.getElementById('theme-icon') as HTMLElement | null;
      const swatches = Array.from(document.querySelectorAll<HTMLButtonElement>('[data-swatch]'));

      const syncSwatches = () => {
        const cur = root.getAttribute('data-accent') || 'blue';
        swatches.forEach((s) => s.setAttribute('aria-pressed', String(s.dataset.accent === cur)));
      };
      const syncIcon = () => {
        if (!icon) return;
        const isDark = root.getAttribute('data-theme') !== 'light';
        icon.outerHTML = isDark
          ? '<svg id="theme-icon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z"/></svg>'
          : '<svg id="theme-icon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"/></svg>';
      };

      toggle?.addEventListener('click', () => {
        const next = root.getAttribute('data-theme') === 'light' ? 'dark' : 'light';
        root.setAttribute('data-theme', next);
        root.classList.toggle('dark', next !== 'light');
        localStorage.setItem('theme', next);
        syncIcon();
      });

      swatches.forEach((s) => {
        s.addEventListener('click', () => {
          const a = s.dataset.accent!;
          root.setAttribute('data-accent', a);
          localStorage.setItem('accent', a);
          syncSwatches();
        });
      });

      syncSwatches();
      syncIcon();
    </script>
  </body>
</html>
