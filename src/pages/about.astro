---
import BaseLayout from '../layouts/BaseLayout.astro';
import Icon from '../components/Icon.astro';
import { site } from '../config/site';
import { getAbout } from '../lib/content';
const { profile, socials } = await getAbout();
---

<BaseLayout title="关于" description={`关于 ${profile.name}`}>
  <div class="about">
    <div class="about-head">
      <img class="avatar" src={profile.avatar} alt={`${profile.name} 头像`} width="120" height="120" />
      <div>
        <h1>{profile.name}</h1>
        <div class="handle">{profile.handle}</div>
        <div class="role">{profile.role}</div>
      </div>
    </div>

    <section>
      <h2 class="section-title"><span class="ico"><Icon name="star" size={18} /></span> 关于我</h2>
      {profile.bio.map((p) => <p>{p}</p>)}
    </section>

    <section>
      <h2 class="section-title"><span class="ico"><Icon name="globe" size={18} /></span> 联系方式</h2>
      <div class="connect-grid">
        {socials.map((s) => (
          <a class="connect-card" href={s.href} target="_blank" rel="noopener noreferrer">
            <Icon name={s.icon} size={18} />
            <span>{s.name}</span>
          </a>
        ))}
        <button class="connect-card" id="copy-email" data-email="admin@xn--ykq675h.cn">
          <Icon name="mail" size={18} />
          <span>admin@神了.cn</span>
        </button>
      </div>
    </section>
  </div>
</BaseLayout>

<script>
  const btn = document.getElementById('copy-email') as HTMLButtonElement | null;
  btn?.addEventListener('click', async () => {
    const email = btn.dataset.email || '';
    try {
      await navigator.clipboard.writeText(email);
      const span = btn.querySelector('span');
      if (span) {
        const old = span.textContent;
        span.textContent = '已复制 ✓';
        setTimeout(() => (span.textContent = old), 1200);
      }
    } catch (e) {
      /* ignore */
    }
  });
</script>

<style>
  .about { margin-top: 32px; }
  .about-head { display: flex; align-items: center; gap: 20px; margin-bottom: 8px; }
  .avatar { width: 96px; height: 96px; border-radius: 24px; box-shadow: 0 6px 20px rgba(0,0,0,.3); }
  .about h1 { margin: 0; font-size: 28px; }
  .handle { color: var(--accent); font-size: 14px; }
  .role { color: var(--muted); font-size: 14px; }
  .about p { max-width: 64ch; color: var(--text); }
  .connect-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(160px, 1fr)); gap: 10px; }
  .connect-card {
    display: flex; align-items: center; gap: 10px; padding: 12px 14px;
    border: 1px solid var(--border); border-radius: 12px; background: var(--bg-soft);
    color: var(--text); cursor: pointer; font: inherit; text-decoration: none;
    transition: color .15s, border-color .15s, transform .15s;
  }
  .connect-card:hover { color: var(--accent); border-color: var(--accent); transform: translateY(-2px); }
  .connect-card svg { color: var(--accent); }
</style>
